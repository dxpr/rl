<?php

/**
 * @file
 * Primary module file for Reinforcement Learning.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\rl\Hook\RlHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_cron().
 */
#[LegacyHook]
function rl_cron() {
  \Drupal::service(RlHooks::class)->cron();
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function rl_theme() {
  return \Drupal::service(RlHooks::class)->theme();
}

/**
 * Implements hook_page_attachments().
 */
#[LegacyHook]
function rl_page_attachments(array &$attachments) {
  \Drupal::service(RlHooks::class)->pageAttachments($attachments);
}

/**
 * Implements hook_preprocess_html().
 */
#[LegacyHook]
function rl_preprocess_html(&$variables) {
  \Drupal::service(RlHooks::class)->preprocessHtml($variables);
}

/**
 * Implements hook_help().
 */
#[LegacyHook]
function rl_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(RlHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_runtime_requirements().
 */
function rl_runtime_requirements(): array {
  // Drupal 11.2 still invokes the legacy requirements hook.
  if (version_compare(\Drupal::VERSION, '11.3.0', '<')) {
    return [];
  }
  \Drupal::moduleHandler()->loadInclude('rl', 'install');
  return rl_requirements('runtime');
}
