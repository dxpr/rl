<?php

/**
 * @file
 * RL Page Title: A/B test page titles for any page.
 */

use Drupal\Component\Render\MarkupInterface;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\ContentEntityFormInterface;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Render\Markup;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\rl\Experiment\VariantParser;
use Drupal\rl_page_title\Entity\PageTitleExperiment;

/**
 * Implements hook_help().
 */
function rl_page_title_help($route_name, RouteMatchInterface $route_match) {
  if ($route_name === 'help.page.rl_page_title') {
    return '<p>' . t('A/B test page titles for any page using Thompson Sampling. Source-agnostic: works for nodes, Views displays, custom controllers, and any path. Manage experiments at <a href=":url">RL Page Title experiments</a>.', [
      ':url' => Url::fromRoute('rl_page_title.collection')->toString(),
    ]) . '</p>';
  }
}

/**
 * Implements hook_preprocess_page_title().
 */
function rl_page_title_preprocess_page_title(array &$variables) {
  $result = _rl_page_title_get_active_variant();
  if ($result && $result['text'] !== NULL) {
    $variables['title'] = $result['text'];
  }
}

/**
 * Implements hook_preprocess_html().
 *
 * Replaces the <title> tag content with the winning variant while preserving
 * the existing structure type (string, MarkupInterface, or render array).
 * Modules like Metatag install a TranslatableMarkup or other MarkupInterface
 * here, and we must not silently downgrade those to a plain string.
 */
function rl_page_title_preprocess_html(array &$variables) {
  $result = _rl_page_title_get_active_variant();
  if (!$result || $result['text'] === NULL) {
    return;
  }
  if (!isset($variables['head_title']['title'])) {
    return;
  }

  $variables['head_title']['title'] = _rl_page_title_replace_head_title($variables['head_title']['title'], $result['text']);
}

/**
 * Replace the head title content while preserving the structure type.
 *
 * @param mixed $existing
 *   The current head_title.title value (string, render array, MarkupInterface).
 * @param string $replacement
 *   The new title text to substitute.
 *
 * @return mixed
 *   A value of the same general shape as $existing.
 */
function _rl_page_title_replace_head_title($existing, string $replacement) {
  // Render array case: keep the structure but swap the inner text where we
  // can find it. Fall back to a plain_text element if the array does not
  // expose a known text field.
  if (is_array($existing)) {
    if (isset($existing['#markup'])) {
      $existing['#markup'] = $replacement;
      return $existing;
    }
    if (isset($existing['#plain_text'])) {
      $existing['#plain_text'] = $replacement;
      return $existing;
    }
    return ['#plain_text' => $replacement];
  }

  // MarkupInterface case (TranslatableMarkup, FormattableMarkup, etc.). We
  // cannot mutate these objects in place; the safe replacement is a Markup
  // wrapper around the new text. Use Markup::create which trusts the input,
  // safe here because $replacement comes from admin-managed config that
  // already passed through Twig autoescape on render.
  if ($existing instanceof MarkupInterface) {
    return Markup::create($replacement);
  }

  // Plain string case.
  return $replacement;
}

/**
 * Implements hook_page_attachments().
 *
 * Always attaches a cache tag for the current internal path, regardless of
 * whether an experiment exists yet. This is critical: if a page is cached
 * BEFORE an experiment is created for it, the cache tag must already be on
 * the cached page so that creating the experiment can invalidate the stale
 * page render. Without this, "creating a new experiment for /blog" would
 * not invalidate the cached /blog page until it expired naturally.
 */
function rl_page_title_page_attachments(array &$attachments) {
  // Tag every page with the path-scoped tag so future experiment creation
  // can invalidate stale renders. This adds two cache tags per request,
  // which is negligible.
  $internal_path = _rl_page_title_current_internal_path();
  $attachments['#cache']['tags'][] = 'rl_page_title:' . $internal_path;
  $attachments['#cache']['tags'][] = 'rl_page_title:all';

  // Attach tracking JS only when an experiment is actually active.
  $result = _rl_page_title_get_active_variant();
  if (!$result) {
    return;
  }

  $rl_path = \Drupal::service('extension.list.module')->getPath('rl');
  $base_path = \Drupal::request()->getBasePath();

  $attachments['#attached']['library'][] = 'rl_page_title/tracking';
  $attachments['#attached']['drupalSettings']['rlPageTitle'] = [
    'experimentId' => $result['experiment_id'],
    'armId' => $result['arm_id'],
    'rlEndpointUrl' => $base_path . '/' . $rl_path . '/rl.php',
  ];
}

/**
 * Get the active variant for the current page (cached per request).
 *
 * @return array|null
 *   Selection result with experiment_id, arm_id, text; or NULL if no
 *   experiment is active for the current page.
 */
function _rl_page_title_get_active_variant(): ?array {
  return \Drupal::service('rl_page_title.variant_selector')->selectForCurrentPage();
}

/**
 * Get the canonical internal path for the current request.
 */
function _rl_page_title_current_internal_path(): string {
  return PageTitleExperiment::normalizePath(\Drupal::service('path.current')->getPath());
}

/**
 * Implements hook_form_alter().
 *
 * Adds the page title variants vertical tab to content entity edit forms
 * for entities that have a canonical link template.
 */
function rl_page_title_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $form_object = $form_state->getFormObject();
  if (!($form_object instanceof ContentEntityFormInterface)) {
    return;
  }
  $operation = $form_object->getOperation();
  if (!in_array($operation, ['default', 'edit'], TRUE)) {
    return;
  }

  $entity = $form_object->getEntity();
  if (!$entity instanceof ContentEntityInterface || $entity->isNew()) {
    return;
  }
  if (!$entity->hasLinkTemplate('canonical')) {
    return;
  }
  if (!\Drupal::currentUser()->hasPermission('administer rl page title experiments')) {
    return;
  }

  // Resolve the entity's canonical internal path (normalized).
  try {
    $internal_path = PageTitleExperiment::normalizePath('/' . $entity->toUrl('canonical')->getInternalPath());
  }
  catch (\Exception $e) {
    return;
  }

  // Look up an existing experiment for this path, if any.
  /** @var \Drupal\rl_page_title\Entity\PageTitleExperiment|null $existing */
  $existing = NULL;
  $matches = \Drupal::entityTypeManager()
    ->getStorage('rl_page_title_experiment')
    ->loadByProperties(['path' => $internal_path]);
  if ($matches) {
    $candidate = reset($matches);
    if ($candidate instanceof PageTitleExperiment) {
      $existing = $candidate;
    }
  }

  $form['rl_page_title'] = [
    '#type' => 'details',
    '#title' => t('Title variants'),
    '#group' => 'advanced',
    '#open' => FALSE,
    '#weight' => 50,
    '#tree' => TRUE,
    '#access' => TRUE,
  ];

  if ($existing) {
    $rl_experiment_id = $existing->getRlExperimentId();
    $total = \Drupal::service('rl.experiment_manager')->getTotalTurns($rl_experiment_id);
    $variant_count = count($existing->getVariants()) + 1;
    // Only link to the report if there's data to show.
    $report_link = '';
    if ($total > 0) {
      $report_url = Url::fromRoute('rl.reports.experiment_detail', [
        'experiment_id' => $rl_experiment_id,
      ]);
      $report_link = ' <a href="' . $report_url->toString() . '" target="_blank">' . t('View report') . '</a>';
    }
    $form['rl_page_title']['status'] = [
      '#type' => 'item',
      '#markup' => t('<strong>@state</strong>: @variants variants, @impressions impressions.', [
        '@state' => $existing->status() ? t('Active') : t('Disabled'),
        '@variants' => $variant_count,
        '@impressions' => $total,
      ]) . $report_link,
    ];
  }
  else {
    $form['rl_page_title']['intro'] = [
      '#type' => 'item',
      '#markup' => '<p>' . t('Add alternative titles to test which performs best. The original title is always tested as variant 1; the lines below are tested against it.') . '</p>',
    ];
  }

  $form['rl_page_title']['variants'] = [
    '#type' => 'textarea',
    '#title' => t('Alternative titles'),
    '#description' => t('One alternative per line. Leave empty to remove the experiment.'),
    '#default_value' => $existing ? implode("\n", $existing->getVariants()) : '',
    '#rows' => 4,
  ];

  $form['rl_page_title']['enabled'] = [
    '#type' => 'checkbox',
    '#title' => t('Enable experiment'),
    '#default_value' => $existing ? (bool) $existing->status() : TRUE,
  ];

  $form['rl_page_title']['advanced_link'] = [
    '#type' => 'item',
    '#markup' => $existing
      ? '<small>' . t('<a href=":url">Open the full experiment form</a> for advanced options.', [':url' => $existing->toUrl('edit-form')->toString()]) . '</small>'
      : '<small>' . t('<a href=":url">Open the full experiment form</a> for advanced options.', [':url' => Url::fromRoute('entity.rl_page_title_experiment.add_form', [], ['query' => ['path' => $internal_path]])->toString()]) . '</small>',
  ];

  // Stash the resolved internal path for the submit handler.
  $form['rl_page_title']['_path'] = [
    '#type' => 'value',
    '#value' => $internal_path,
  ];
  if ($existing) {
    $form['rl_page_title']['_existing_id'] = [
      '#type' => 'value',
      '#value' => $existing->id(),
    ];
  }

  // Attach our submit handler to all submit-style actions on the form, not
  // just the canonical Save button. Workflow modules often add additional
  // submit actions (publish, save as draft, etc.) and we need the experiment
  // to update regardless of which action the user clicks.
  if (isset($form['actions']) && is_array($form['actions'])) {
    foreach (Element::children($form['actions']) as $action_key) {
      if (isset($form['actions'][$action_key]['#type']) && $form['actions'][$action_key]['#type'] === 'submit') {
        $form['actions'][$action_key]['#submit'][] = '_rl_page_title_entity_form_submit';
      }
    }
  }
}

/**
 * Submit handler for the vertical tab on entity forms.
 *
 * Creates, updates, or deletes the experiment based on the textarea content.
 * Wraps writes in a try/catch so a failure here cannot break the user's
 * primary entity save flow.
 */
function _rl_page_title_entity_form_submit(array &$form, FormStateInterface $form_state) {
  $values = $form_state->getValue('rl_page_title');
  if (empty($values)) {
    return;
  }

  $internal_path = $values['_path'] ?? NULL;
  if (!$internal_path) {
    return;
  }

  $variants = VariantParser::parse((string) ($values['variants'] ?? ''));
  $storage = \Drupal::entityTypeManager()->getStorage('rl_page_title_experiment');
  $existing_id = $values['_existing_id'] ?? NULL;
  $experiment = NULL;
  if ($existing_id) {
    $loaded = $storage->load($existing_id);
    if ($loaded instanceof PageTitleExperiment) {
      $experiment = $loaded;
    }
  }

  try {
    if (empty($variants)) {
      if ($experiment !== NULL) {
        $rl_id = $experiment->getRlExperimentId();
        // Purge analytics first. If this fails the config entity is still
        // around as a recovery anchor, avoiding orphaned analytics rows.
        \Drupal::service('rl.experiment_manager')->purgeExperiment($rl_id);
        $experiment->delete();
        \Drupal::messenger()->addStatus(t('Title experiment removed.'));
      }
      return;
    }

    if ($experiment === NULL) {
      // Build a stable machine name from the canonical RL experiment ID so
      // the config and analytics IDs stay aligned.
      $machine = 'pt_' . substr(PageTitleExperiment::buildRlExperimentId($internal_path), strlen('rl_page_title-'));
      $form_object = $form_state->getFormObject();
      $entity_label = $internal_path;
      if ($form_object instanceof EntityFormInterface) {
        $entity = $form_object->getEntity();
        $entity_label = $entity->label() ?? $internal_path;
      }
      $label = (string) t('Page title: @entity', ['@entity' => $entity_label]);
      $created = $storage->create([
        'id' => $machine,
        'label' => $label,
        'path' => $internal_path,
      ]);
      assert($created instanceof PageTitleExperiment);
      $experiment = $created;
    }

    $experiment->setVariants($variants);
    $experiment->set('enabled', !empty($values['enabled']));
    $experiment->save();

    // Register with the RL experiment registry.
    \Drupal::service('rl.experiment_registry')->register(
      $experiment->getRlExperimentId(),
      'rl_page_title',
      $experiment->label()
    );

    Cache::invalidateTags(['rl_page_title:' . $experiment->getPath()]);

    \Drupal::messenger()->addStatus(t('Title experiment saved.'));
  }
  catch (\Exception $e) {
    \Drupal::logger('rl_page_title')->error('Failed to save title experiment from entity form: @message', ['@message' => $e->getMessage()]);
    \Drupal::messenger()->addError(t('Could not save title experiment: @message', ['@message' => $e->getMessage()]));
  }
}

/**
 * Implements hook_entity_predelete().
 *
 * Cleans up page title experiments when the target entity is deleted, and
 * also purges the corresponding RL analytics tables.
 */
function rl_page_title_entity_predelete(EntityInterface $entity) {
  if (!$entity instanceof ContentEntityInterface) {
    return;
  }
  if (!$entity->hasLinkTemplate('canonical')) {
    return;
  }

  try {
    $internal_path = PageTitleExperiment::normalizePath('/' . $entity->toUrl('canonical')->getInternalPath());
  }
  catch (\Exception $e) {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('rl_page_title_experiment');
  $matches = $storage->loadByProperties(['path' => $internal_path]);
  if (!$matches) {
    return;
  }
  $manager = \Drupal::service('rl.experiment_manager');
  foreach ($matches as $experiment) {
    if (!$experiment instanceof PageTitleExperiment) {
      continue;
    }
    $rl_id = $experiment->getRlExperimentId();
    // Purge analytics first; if it fails, the config entity is still around
    // for a retry.
    $manager->purgeExperiment($rl_id);
    $experiment->delete();
  }
}
