<?php

/**
 * @file
 * RL Example module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\rl_example\Hook\RlExampleHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function rl_example_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(RlExampleHooks::class)->help($route_name, $route_match);
}
