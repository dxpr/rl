<?php

/**
 * @file
 * RL Example Frontend module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\rl_example_frontend\Hook\RlExampleFrontendHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function rl_example_frontend_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(RlExampleFrontendHooks::class)->help($route_name, $route_match);
}
